# Google Sheets integration via Apps Script — server-side only.
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Full setup walkthrough: google-apps-script/README.md

# The Web App /exec URL from your Apps Script deployment.
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# A long random string. Must match SHARED_SECRET at the top of
# google-apps-script/Code.gs exactly, or the script rejects every submission.
GOOGLE_APPS_SCRIPT_SECRET=replace-with-a-long-random-string
