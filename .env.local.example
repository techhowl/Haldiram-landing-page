# Google Sheets integration — server-side only. Copy this file to
# `.env.local` and fill in real values. Never commit `.env.local`.

# The `client_email` field from your Google Cloud service account JSON key.
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The `private_key` field from the same JSON key file. Keep the quotes and
# the literal "\n" sequences exactly as they appear in the JSON file —
# the app un-escapes them at runtime.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID, taken from its URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
